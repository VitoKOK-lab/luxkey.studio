# 複製為 config/ai.env（Git 忽略）。有可用的 Agent 後再填寫連接設定。
PALACE_AI_PROVIDER=agent
# 一個 JSON 字串陣列，第一項是執行檔，其餘為引數。完整協定見 docs/agent-protocol.md。
# 例：["/absolute/path/to/agent-bridge", "--memory-palace"]
PALACE_AGENT_COMMAND_JSON=
# 只有選定的 Agent 能接收截圖時才設為 true。
PALACE_AI_VISION=false

# 選用 HTTP API 時，將 PALACE_AI_PROVIDER 改成 openai-compatible 或 anthropic。
# URL、模型與金鑰都填妥才會呼叫 API。anthropic 的網址通常以 /v1 結尾。
PALACE_AI_BASE_URL=
PALACE_AI_MODEL=
PALACE_AI_API_KEY=
# OpenAI 相容 API 的回覆格式可使用 json_schema 或 json_object。
PALACE_AI_FORMAT=json_schema
PALACE_AI_ANTHROPIC_VERSION=2023-06-01
